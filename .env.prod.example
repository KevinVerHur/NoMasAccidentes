# Copia como .env.prod EN LA INSTANCIA y completa los valores.
# NO subir .env.prod al repositorio (ya esta en .gitignore como .env*).

# --- Dominio HTTPS (DuckDNS) ---
# El subdominio que creaste en https://www.duckdns.org (sin https://, sin barra).
SITE_ADDRESS=nomasaccidentes.duckdns.org

# --- Base de datos (interna al compose) ---
MYSQL_DATABASE=no_mas_accidentes
MYSQL_ROOT_PASSWORD=pon_un_root_password_fuerte
DB_USER=nma_user
DB_PASS=pon_un_password_fuerte

# --- Seguridad ---
# Genera uno largo (>=256 bits). Ej: openssl rand -base64 48
JWT_SECRET=reemplazar_por_clave_larga_aleatoria_minimo_256_bits

# --- Perfil backend ---
SPRING_PROFILES_ACTIVE=dev

# --- Correo ---
# Por defecto usa Mailpit interno (los correos NO llegan a inboxes reales,
# se ven en http://localhost:8025 via tunel SSH). Para envio real, descomenta:
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587
#MAIL_USER=tu_correo@gmail.com
#MAIL_PASS=tu_app_password_de_gmail
#SMTP_AUTH=true
#SMTP_STARTTLS=true
APP_ADMIN_EMAIL=admin@nma.local

# --- AWS S3 (opcional; vacio = informes en disco local de la instancia) ---
AWS_S3_BUCKET=
AWS_REGION=us-east-1
