# Copia este archivo como .env si necesitas personalizar el entorno Docker local.
# No subas credenciales reales al repositorio.

MYSQL_DATABASE=no_mas_accidentes
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=cambiar_root_password_local
DB_USER=nma_user
DB_PASS=cambiar_password_local

BACKEND_PORT=8080
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080

SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=cambiar_por_clave_local_larga_minimo_256_bits_1234567890
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_FRONTEND_URL=http://localhost:5173

# Correo: por defecto Mailpit (SMTP falso de desarrollo). Web UI: http://localhost:8025
# Atrapa todos los correos salientes; no requiere credenciales reales.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=dev@nma.local
MAIL_PASS=
APP_ADMIN_EMAIL=admin@nma.local
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- Envío real vía Gmail u otro SMTP (descomentar y comentar el bloque Mailpit) ---
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587
#MAIL_USER=tu_correo@gmail.com
#MAIL_PASS=tu_app_password
#APP_ADMIN_EMAIL=admin@tuempresa.cl

AWS_S3_BUCKET=
AWS_REGION=us-east-1
